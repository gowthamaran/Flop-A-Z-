    }
  },
  "flop_cli": {
    "package": "@flop-labs/cli",
    "version": "0.7.0",
    "mcp_url": "https://mcp.flop.network/mcp",
    "password_env": "FLOP_KEYSTORE_PASSWORD",
    "_comment": "Command templates taken from `flop --help` of @flop-labs/cli 0.7.0. Each template is re-checked against the installed CLI's --help before it runs, so a future CLI change fails safely. Edit here if your CLI version differs.",
    "commands": {
      "keys_generate": "flop --offline keys generate --type sr25519 --name flop-az-agent --out {keystore} --password-env FLOP_KEYSTORE_PASSWORD",
      "keys_inspect": "flop --offline keys inspect {keystore} --json",
      "network_status": "flop --network {network} network status",
      "faucet": "flop --network {network} faucet request {address}",
      "balance": "flop --network {network} balance {address}",
      "agent_init": "flop --network {network} agent init --client generic",
      "agent_doctor": "flop --network {network} agent doctor --check-rpc",
      "infer": "flop --network {network} --keystore {keystore} --password-env FLOP_KEYSTORE_PASSWORD chat --max-flop {max_spend} {prompt}",
      "hermes_plan": "flop --network {network} --keystore {keystore} --password-env FLOP_KEYSTORE_PASSWORD hermes direct --terminal --max-flop {max_spend} --budget-flop {budget} --state {state} --dry-run",
      "hermes_launch": "flop --network {network} --keystore {keystore} --password-env FLOP_KEYSTORE_PASSWORD hermes direct --terminal --max-flop {max_spend} --budget-flop {budget} --state {state}",
      "validator_init": "flop --network {network} validator init",
      "validator_doctor": "flop --network {network} --rpc {rpc} validator doctor",
      "validator_status": "flop --network {network} validator status {address}",
      "health": "flop --network {network} --rpc {rpc} health"
    }
  },
  "registration": {
    "operator_form": "https://github.com/flop-labs/network/issues/new?template=operator-application.yml",
    "validator_prep_kit": "https://docs.flop.network/testnet-validator-prep/",
    "validator_interest": "https://flop.finance/apply/validator",
    "miner_interest": "https://flop.finance/apply/miner"
  },
  "hermes": {
    "installer": "https://hermes-agent.nousresearch.com/install.sh",
    "docs": "https://hermes-agent.nousresearch.com/"
  }
